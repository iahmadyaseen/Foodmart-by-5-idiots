{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile for Food Mart customers and admins.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["userId", "name", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Food Mart product catalog item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "categoryName": { "type": "string" },
        "subcategory": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "sale": { "type": "boolean" },
        "unit": { "type": "string" },
        "stockQuantity": { "type": "number" },
        "stockStatus": { "type": "string" },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sku", "name", "category", "price", "unit", "stockQuantity"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order in Food Mart.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "postalCode": { "type": "string" },
        "notes": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "orderStatus": { "type": "string" },
        "createdAt": { "type": "string" },
        "estimatedDelivery": { "type": "string" }
      },
      "required": ["orderId", "userId", "customerEmail", "total", "items"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inbound inquiry or contact form submission.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "message"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User account profiles."
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Catalog products."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    },
    "contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Contact form submissions."
    }
  }
}
